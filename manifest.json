{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.0.0",
  "minimum_chrome_version": "110",
  "description": "__MSG_appDescription__",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.netflix.com/*",
        "https://video.unext.jp/*",
        "https://www.hulu.jp/*",
        "https://hulu.jp/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.disneyplus.com/*",
        "https://disneyplus.com/*",
        "https://www.primevideo.com/*",
        "https://primevideo.com/*",
        "https://www.amazon.co.jp/gp/video/*",
        "https://www.amazon.co.jp/detail/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.com/detail/*",
        "https://tv.apple.com/*",
        "https://abema.tv/*",
        "https://tver.jp/*",
        "https://www.hulu.com/*",
        "https://hulu.com/*"
      ],
      "js": [
        "constants.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "zoom-in": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "__MSG_zoomIn__"
    },
    "zoom-out": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "__MSG_zoomOut__"
    },
    "reset": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "__MSG_resetCommand__"
    }
  },
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
